{
  "compilerOptions": {
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.cache/tsc-web",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite-plus/client"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "paths": { "@/*": ["./web/src/*"] }
  },
  "include": [
    "web/src",
    "extensions/**/*.tsx",
    ".ultimate/extensions/**/*.tsx",
    "shared/protocol.ts",
    "shared/events.ts",
    "shared/extension-api.ts",
    "extensions/*/refs.ts",
    ".ultimate/extensions/*/refs.ts",
    "extensions/messages/caller.ts",
    "extensions/projects/links.ts",
    "extensions/cloud/types.ts",
    "extensions/tailscale/state.ts",
    "extensions/cloud/run.ts",
    "extensions/conversations/types.ts",
    "extensions/dream/state.ts",
    "extensions/dream/types.ts",
    "extensions/lineage/types.ts",
    "extensions/phase/types.ts",
    "extensions/recall/state.ts",
    "extensions/recall/types.ts",
    "extensions/conversations/summary-model-ref.ts",
    "extensions/models/switches.ts",
    "extensions/models/login-state.ts",
    "extensions/models/owner.ts",
    "extensions/context/breakdown.ts",
    "extensions/status-line/context.ts",
    "extensions/status-line/turns.ts",
    "extensions/sounds/cues.ts",
    "extensions/keep-warm/due.ts",
    "extensions/workspaces/queue.ts",
    "extensions/workspaces/state.ts",
    "extensions/quota/chip.ts",
    "extensions/goal/state.ts",
    "extensions/automations/condition.ts",
    "extensions/automations/state.ts",
    "extensions/theme/palette.ts",
    "extensions/theme/fonts.ts",
    "extensions/sounds/tones.ts",
    "extensions/sounds/agents.ts",
    "extensions/sounds/conductor.ts",
    "extensions/sounds/engine.ts",
    "extensions/sounds/narration.ts",
    "extensions/sounds/speaker.ts",
    "extensions/instance/links.ts",
    "extensions/update/item.ts",
    "extensions/attachments/limits.ts",
    "extensions/pause/lasted.ts",
    "extensions/pause/parked.ts",
    "extensions/pause/state.ts",
    "extensions/sidebar/work.ts",
    "extensions/sidebar/landings.ts",
    "extensions/subagents/landing.ts",
    "extensions/onboarding/onboarded.ts",
    "extensions/tasks/kinds.ts",
    "extensions/sidebar/listed.ts",
    "extensions/ideas/stage.ts",
    "extensions/side-chat/logic.ts",
    "extensions/voice-live/mode.ts",
    "extensions/voice-live/relay.ts",
    "extensions/voice-live/session.ts",
    "extensions/system/feed.ts",
    "extensions/system/layout.ts",
    "extensions/workspaces/types.ts",
    "extensions/review/comments.ts",
    "extensions/review/types.ts",
    "extensions/review/drafts.ts",
    "extensions/review/lines.ts",
    "extensions/review/sha256.ts",
    "lib/activity.ts",
    "lib/concluded.ts",
    "lib/ago.ts",
    "lib/compare.ts",
    "lib/context-usage.ts",
    "lib/entries.ts",
    "lib/families.ts",
    "lib/marks.ts",
    "lib/message-state.ts",
    "lib/source-frames.ts",
    "lib/standing.ts",
    "lib/todos.ts",
    "extensions/subagents/message-types.ts",
    "test/web",
    "extensions/*/test/web"
  ]
}
