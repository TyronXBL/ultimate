{
  "extensions": {
    "enable": ["voice-live"]
  },
  "modelFamilies": {
    "families": {
      "lead": { "model": "claude-code/claude-opus-5-5", "thinking": "high", "color": "orange" },
      "design": { "model": "anthropic/claude-opus-5-5", "thinking": "medium" },
      "review": { "model": "openai-codex/gpt-6.1-terra", "thinking": "high" },
      "critic": { "model": "anthropic/claude-sonnet-5-5", "thinking": "high" },
      "build": { "model": "openai-codex/gpt-6-luna", "thinking": "medium" },
      "fast": { "model": "openai-codex/gpt-6.1-sol" },
      "recon": { "model": "antigravity/gemini-3.8-flash", "thinking": "medium" },
      "research": { "model": "anthropic/claude-sonnet-5-5", "thinking": "high" }
    },
    "assign": {
      "preview": "fast"
    }
  },
  "isolates": {
    "worktree": {
      "setup": ["pnpm install --frozen-lockfile --prefer-offline"]
    }
  },
  "lander": {
    "checks": [
      { "command": "pnpm check", "timeout": 120 },
      { "command": "pnpm audit --audit-level high --ignore-registry-errors", "timeout": 120 },
      { "command": "node .ultimate/scripts/ci-gate.ts fork", "timeout": 1800 }
    ],
    "push": "fork"
  }
}
