{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "bin/*.ts",
    "scripts/*.ts",
    ".ultimate/skills/**/*.ts",
    ".ultimate/scripts/*.ts",
    "extensions/*/{server,api,refs}.ts",
    "extensions/*/{web,ui}.tsx",
    ".ultimate/extensions/*/{server,api,refs}.ts",
    ".ultimate/extensions/*/{web,ui}.tsx",
    "web/src/sdk/index.ts",
    "test/**/*.test.ts",
    "test/mutation.config.ts"
  ],
  "project": ["**/*.{ts,tsx,css}"],
  "ignoreBinaries": ["loginctl", "bsdtar"],
  "ignoreDependencies": ["@stryker-mutator/vitest-runner"],
  "ignore": ["web/src/lib/utils.ts", ".ultimate/skills/preview-demo/fixture/**"]
}
